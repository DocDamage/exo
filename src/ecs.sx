pub type Vec3 = {
    x: f32
    y: f32
    z: f32
}

pub type SurfaceMaterial = {
    color: Vec3
    reflective: f32
    emissive: f32
}

pub spec SceneEntity = {
    pub fn se_position(e: self) Vec3
    pub fn se_color(e: self) Vec3
    pub fn se_scale(e: self) f32
    pub fn se_rotation(e: self, time: f32) f32
    pub fn se_reflective(e: self) f32
    pub fn se_emissive(e: self) f32
    pub fn se_is_sphere(e: self) bool
}

pub type (SceneEntity) SphereEntity = {
    position: mut Vec3
    color: Vec3
    radius: f32
    velocity: mut Vec3
    reflective: f32
    emissive: f32
}

pub type (SceneEntity) CubeEntity = {
    position: mut Vec3
    color: Vec3
    size: f32
    rotation_speed: f32
    velocity: mut Vec3
    reflective: f32
    emissive: f32
}

pub fn (SphereEntity) se_position(e: self) Vec3 = { return e.position }
pub fn (SphereEntity) se_color(e: self) Vec3 = { return e.color }
pub fn (SphereEntity) se_scale(e: self) f32 = { return e.radius }
pub fn (SphereEntity) se_rotation(_: self, _: f32) f32 = { return 0.0 as f32 }
pub fn (SphereEntity) se_reflective(e: self) f32 = { return e.reflective }
pub fn (SphereEntity) se_emissive(e: self) f32 = { return e.emissive }
pub fn (SphereEntity) se_is_sphere(_: self) bool = { return true }

pub fn (CubeEntity) se_position(e: self) Vec3 = { return e.position }
pub fn (CubeEntity) se_color(e: self) Vec3 = { return e.color }
pub fn (CubeEntity) se_scale(e: self) f32 = { return e.size }
pub fn (CubeEntity) se_rotation(e: self, time: f32) f32 = { return time * e.rotation_speed }
pub fn (CubeEntity) se_reflective(e: self) f32 = { return e.reflective }
pub fn (CubeEntity) se_emissive(e: self) f32 = { return e.emissive }
pub fn (CubeEntity) se_is_sphere(_: self) bool = { return false }

pub type PointLight = {
    position: Vec3
    color: Vec3
    intensity: f32
    radius: f32
}

pub type GlbModel = {
    valid: mut bool
    byte_length: mut usize
    json_length: mut usize
    bin_length: mut usize
    mesh_name: mut ref u8
    primitive_count: mut i32
    vertex_count: mut i32
    index_count: mut i32
    has_normals: mut bool
    has_uvs: mut bool
    raw_bytes: mut ref u8
    raw_bytes_len: mut usize
    bounds_min_x: mut f32
    bounds_max_x: mut f32
    bounds_min_y: mut f32
    bounds_max_y: mut f32
    bounds_min_z: mut f32
    bounds_max_z: mut f32
    texture_offset: mut usize
    texture_length: mut usize
}

pub type FloorCollider = {
    y: f32
    restitution: f32
    offset_x: f32
    offset_z: f32
    size_x: f32
    size_z: f32
    thickness: f32
    color: Vec3
}

pub type WaterSurface = {
    y: f32
    offset_x: f32
    offset_z: f32
    wave_speed: f32
    wave_amplitude: f32
    wave_frequency: f32
    size_x: f32
    size_z: f32
    fit_scale: f32
    color: Vec3
    corner_radius: f32
}

pub type Scene3D = {
    spheres: mut list[SphereEntity]
    cubes: mut list[CubeEntity]
    model: mut GlbModel
    model_position: mut Vec3
    model_scale: mut f32
    model_rotation_y: mut f32
    light: PointLight
    gravity: mut f32
    floor: mut option[FloorCollider]
    water: mut option[WaterSurface]
}

pub fn make_vec3(x: f32, y: f32, z: f32) Vec3 = {
    return { x: x, y: y, z: z }
}

pub fn default_sphere_material(color: Vec3) SurfaceMaterial = {
    return { color: color, reflective: 0.12 as f32, emissive: 0.0 as f32 }
}

pub fn default_cube_material(color: Vec3) SurfaceMaterial = {
    return { color: color, reflective: 0.08 as f32, emissive: 0.0 as f32 }
}

pub fn make_sphere_with_material(position: Vec3, radius: f32, material: SurfaceMaterial) SphereEntity = {
    return {
        position: position,
        color: material.color,
        radius: radius,
        velocity: make_vec3(0.0 as f32, 0.0 as f32, 0.0 as f32),
        reflective: material.reflective,
        emissive: material.emissive
    }
}

pub fn make_sphere(position: Vec3, color: Vec3, radius: f32) SphereEntity = {
    return make_sphere_with_material(position, radius, default_sphere_material(color))
}

pub fn make_cube_with_material(position: Vec3, size: f32, rotation_speed: f32, material: SurfaceMaterial) CubeEntity = {
    return {
        position: position,
        color: material.color,
        size: size,
        rotation_speed: rotation_speed,
        velocity: make_vec3(0.0 as f32, 0.0 as f32, 0.0 as f32),
        reflective: material.reflective,
        emissive: material.emissive
    }
}

pub fn make_cube(position: Vec3, color: Vec3, size: f32, rotation_speed: f32) CubeEntity = {
    return make_cube_with_material(position, size, rotation_speed, default_cube_material(color))
}

pub fn make_floor_surface(
    y: f32,
    restitution: f32,
    offset_x: f32,
    offset_z: f32,
    size_x: f32,
    size_z: f32,
    thickness: f32,
    color: Vec3
) FloorCollider = {
    return {
        y: y,
        restitution: restitution,
        offset_x: offset_x,
        offset_z: offset_z,
        size_x: size_x,
        size_z: size_z,
        thickness: thickness,
        color: color
    }
}

pub fn make_floor(y: f32, restitution: f32) FloorCollider = {
    return make_floor_surface(
        y,
        restitution,
        0.0 as f32,
        -1.45 as f32,
        7.8 as f32,
        7.8 as f32,
        0.16 as f32,
        make_vec3(0.03 as f32, 0.06 as f32, 0.08 as f32)
    )
}

pub fn make_water(y: f32, offset_x: f32, offset_z: f32, size_x: f32, size_z: f32, color: Vec3, wave_speed: f32, wave_amplitude: f32, wave_frequency: f32, corner_radius: f32) WaterSurface = {
    return {
        y: y,
        offset_x: offset_x,
        offset_z: offset_z,
        wave_speed: wave_speed,
        wave_amplitude: wave_amplitude,
        wave_frequency: wave_frequency,
        size_x: size_x,
        size_z: size_z,
        fit_scale: 1.0 as f32,
        color: color,
        corner_radius: corner_radius
    }
}

pub fn default_light() PointLight = {
    return {
        position: make_vec3(0.0 as f32, 4.0 as f32, 0.0 as f32),
        color: make_vec3(1.0 as f32, 0.92 as f32, 0.78 as f32),
        intensity: 1.6 as f32,
        radius: 7.0 as f32
    }
}

pub fn make_light(position: Vec3, color: Vec3, intensity: f32, radius: f32) PointLight = {
    return { position: position, color: color, intensity: intensity, radius: radius }
}

pub fn empty_model() GlbModel = {
    return {
        valid: false,
        byte_length: 0 as usize,
        json_length: 0 as usize,
        bin_length: 0 as usize,
        mesh_name: "",
        primitive_count: 0 as i32,
        vertex_count: 0 as i32,
        index_count: 0 as i32,
        has_normals: false,
        has_uvs: false,
        raw_bytes: none as ref u8,
        raw_bytes_len: 0 as usize,
        bounds_min_x: 0.0 as f32,
        bounds_max_x: 0.0 as f32,
        bounds_min_y: 0.0 as f32,
        bounds_max_y: 0.0 as f32,
        bounds_min_z: 0.0 as f32,
        bounds_max_z: 0.0 as f32,
        texture_offset: 0 as usize,
        texture_length: 0 as usize
    }
}

pub fn new_scene(light: PointLight) Scene3D = {
    return {
        spheres: [],
        cubes: [],
        model: empty_model(),
        model_position: make_vec3(0.0 as f32, 0.0 as f32, 0.0 as f32),
        model_scale: 1.0 as f32,
        model_rotation_y: 0.0 as f32,
        light: light,
        gravity: 9.8 as f32,
        floor: none,
        water: none
    }
}
