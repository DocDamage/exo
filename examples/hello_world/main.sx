val ecs    = use("../../src/ecs.sx")
val engine = use("../../src/engine.sx")
val exo    = use("../../src/exo.sx")
val world  = use("../../src/world.sx")

fn build_scene() ecs.Scene3D = {
    val state: mut world.World = world.new_world()
    state.gravity = 0.0 as f32
    state.floor = some ecs.make_floor(-1.0 as f32, 0.2 as f32)
    state.light = ecs.make_light(
        ecs.make_vec3(0.0 as f32, 4.0 as f32, 1.0 as f32),
        ecs.make_vec3(1.0 as f32, 1.0 as f32, 1.0 as f32),
        1.8 as f32,
        8.0 as f32
    )

    val cube = world.create_entity(state)
    world.set_transform(state, cube, world.make_transform(
        ecs.make_vec3(0.0 as f32, 0.0 as f32, -2.5 as f32),
        1.0 as f32
    ))
    world.set_renderable(state, cube, world.cube_renderable(
        ecs.default_cube_material(ecs.make_vec3(0.25 as f32, 0.72 as f32, 1.00 as f32)),
        1.0 as f32
    ))

    val sphere = world.create_entity(state)
    world.set_transform(state, sphere, world.make_transform(
        ecs.make_vec3(1.8 as f32, 0.0 as f32, -3.0 as f32),
        0.7 as f32
    ))
    world.set_renderable(state, sphere, world.sphere_renderable(
        ecs.default_sphere_material(ecs.make_vec3(1.00 as f32, 0.42 as f32, 0.32 as f32))
    ))

    return world.to_scene(state)
}

pub fn main() i32 = {
    val scenes: mut list[ecs.Scene3D] = []
    @append(scenes, build_scene())

    val builder: mut engine.ExoAppBuilder = exo.new_app()
    engine.with_title(builder, "Exo Hello World")
    engine.with_resolution(builder, 1280 as i32, 720 as i32)
    engine.with_scene_list(builder, scenes)
    engine.with_default_camera(builder)
    engine.with_mouse_config(builder, {
        enabled: true,
        sensitivity_x: 0.002 as f32,
        sensitivity_y: 0.002 as f32,
        invert_y: false
    })

    return trust exo.run(exo.build_app(builder))
}
