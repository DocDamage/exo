val ecs    = use("../../src/ecs.sx")
val engine = use("../../src/engine.sx")
val exo    = use("../../src/exo.sx")
val math   = use("std/math")

val FLAKE_COUNT: i32 = 32
val MIN_X: f32 = -3.2
val MAX_X: f32 = 3.2
val MIN_Z: f32 = -3.6
val MAX_Z: f32 = -0.2
val RESPAWN_Y: f32 = 3.9
val FLOOR_Y: f32 = -0.2

type (engine.SceneUpdater) SnowUpdater = {}

fn wrap_range(value: f32, minimum: f32, maximum: f32) f32 = {
    val span: f32 = maximum - minimum
    if span <= (0.0 as f32) { return value }
    val wrapped: mut f32 = value
    for wrapped < minimum { wrapped = wrapped + span }
    for wrapped > maximum { wrapped = wrapped - span }
    return wrapped
}

fn respawn_position(index: i32, time: f32) ecs.Vec3 = {
    val phase: f32 = (index as f32) * (0.77 as f32) + time * (0.31 as f32)
    val x_norm: f32 = (math.sin(phase as f64) as f32) * (0.5 as f32) + (0.5 as f32)
    val z_norm: f32 = (math.cos((phase * (1.31 as f32)) as f64) as f32) * (0.5 as f32) + (0.5 as f32)
    return ecs.make_vec3(
        MIN_X + x_norm * (MAX_X - MIN_X),
        RESPAWN_Y,
        MIN_Z + z_norm * (MAX_Z - MIN_Z)
    )
}

pub fn (SnowUpdater) su_update(_: mut self, scene: mut ecs.Scene3D, dt: f32, time: f32) void = {
    val next: mut list[ecs.SphereEntity] = []
    val index: mut i32 = 0 as i32
    for sphere in scene.spheres {
        if index < FLAKE_COUNT {
            val phase: f32 = time * (0.82 as f32) + (index as f32) * (0.63 as f32)
            val speed: f32 = (0.72 as f32) + (math.sin((phase * (1.33 as f32)) as f64) as f32) * (0.22 as f32)
            val x: f32 = wrap_range(sphere.position.x + (math.sin((phase * (1.91 as f32)) as f64) as f32) * (0.36 as f32) * dt, MIN_X, MAX_X)
            val z: f32 = wrap_range(sphere.position.z + (math.cos((phase * (1.57 as f32)) as f64) as f32) * (0.22 as f32) * dt, MIN_Z, MAX_Z)
            val y: f32 = sphere.position.y - speed * dt
            if y <= FLOOR_Y {
                @append(next, ecs.make_sphere(respawn_position(index, time), sphere.color, sphere.radius))
            } else {
                @append(next, ecs.make_sphere(ecs.make_vec3(x, y, z), sphere.color, sphere.radius))
            }
        } else {
            @append(next, sphere)
        }
        index += (1 as i32)
    }
    scene.spheres = next
}

fn build_scene() ecs.Scene3D = {
    val scene: mut ecs.Scene3D = ecs.new_scene(ecs.make_light(
        ecs.make_vec3(-1.2 as f32, 4.5 as f32, 1.8 as f32),
        ecs.make_vec3(0.96 as f32, 0.98 as f32, 1.00 as f32),
        2.2 as f32,
        10.0 as f32
    ))
    scene.gravity = 0.0 as f32
    scene.floor = some ecs.make_floor(FLOOR_Y, 0.0 as f32)

    val index: mut i32 = 0 as i32
    for index < FLAKE_COUNT {
        val position: ecs.Vec3 = respawn_position(index, (index as f32) * (0.4 as f32))
        @append(scene.spheres, ecs.make_sphere(position, ecs.make_vec3(0.98 as f32, 0.99 as f32, 1.0 as f32), 0.06 as f32))
        index += (1 as i32)
    }
    return scene
}

pub fn main() i32 = {
    val scenes: mut list[ecs.Scene3D] = []
    @append(scenes, build_scene())
    val builder: mut engine.ExoAppBuilder = exo.new_app()
    engine.with_title(builder, "Exo Snow")
    engine.with_resolution(builder, 1280 as i32, 720 as i32)
    engine.with_scene_list(builder, scenes)
    engine.with_default_camera(builder)
    engine.with_mouse_config(builder, {
        enabled: true,
        sensitivity_x: 0.0018 as f32,
        sensitivity_y: 0.0018 as f32,
        invert_y: false
    })
    val updater: SnowUpdater = {}
    return trust exo.run_with_scene_updater[SnowUpdater](exo.build_app(builder), updater)
}
